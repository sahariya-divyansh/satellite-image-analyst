# Environment Configuration for Natural-Language Satellite Image Analyst
# Copy this file to .env and configure as needed.

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
DEBUG=false

# Cache Directory for STAC Metadata & Downloaded Geotiffs
CACHE_DIR=./data/cache
MAX_CACHE_SIZE_GB=10

# Default STAC Provider
# Options: planetary_computer | earth_search
STAC_PROVIDER=planetary_computer
PC_SDK_SUBSCRIPTION_KEY=

# LLM Providers (Pluggable; rule-based fallback works if none provided)
# Provider options: rule_based | gemini | openai | ollama
DEFAULT_LLM_PROVIDER=rule_based

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI or OpenAI-Compatible API (e.g. vLLM, Groq)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Ollama Local Service
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Nominatim Geocoding (Include descriptive User-Agent per OSM policy)
GEOCODING_USER_AGENT=satellite-image-analyst/0.1.0 (contact: research@satellite-analyst.local)

# Feature Flags
ENABLE_EXPERIMENTAL_CLIP_SAM=false
